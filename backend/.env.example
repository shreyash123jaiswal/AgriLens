# AgriLens AI — Backend Environment Variables
# Copy this to .env and fill in real keys

# Database (optional for MVP — SQLite fallback used if not set)
DATABASE_URL=

# Weather API (Open-Meteo is free, no key needed)
# Optional: OpenWeatherMap key for extended forecasts
WEATHER_API_KEY=

# AI Farm Advisor (Gemini)
GEMINI_API_KEY=

# Google Earth Engine (optional)
EARTH_ENGINE_PROJECT=

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENV=development
